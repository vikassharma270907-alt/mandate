# Mandate sandbox prototype — copy values into your shell, do not commit .env.
# This file is documentation; the demo does not auto-load it.

# Passport signing key. At least 32 bytes. If unset, a random per-process key
# is generated and all issued passports become invalid on restart.
MANDATE_PASSPORT_KEY=replace-with-at-least-32-random-bytes

# Optional: OpenAI-compatible local LLM endpoint (Ollama example).
MANDATE_LLM_BASE_URL=http://127.0.0.1:11434/v1
MANDATE_LLM_MODEL=qwen2.5-coder:7b
MANDATE_LLM_API_KEY=

# Airwallex sandbox. Leave blank to use the in-memory fake adapter.
# NEVER put a production key here.
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api-demo.airwallex.com
AIRWALLEX_API_VERSION=2022-11-11
AIRWALLEX_CARD_PROGRAM_ID=
AIRWALLEX_TIMEOUT=20
